# Copy to `.env` and fill in. `.env` is gitignored and never committed.
#
#   cp .env.example .env
#
# Recommended -- a Bedrock long-term API key ("ABSK..."). Bearer auth scoped to
# Bedrock only; when set it wins over every option below.
AWS_BEARER_TOKEN_BEDROCK=

# Option A -- paste IAM keys here:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary/STS credentials:
AWS_SESSION_TOKEN=

# Option B -- use a named profile from ~/.aws/credentials instead.
# If set, this wins over the keys above.
# AWS_PROFILE=startup-news

AWS_REGION=ap-south-1

# --- Budget rails -----------------------------------------------------------
# Cover every Bedrock call: LLM structuring and, when on, guardrail checks.
TOTAL_USD_CAP=7.00
DAILY_USD_CAP=0.50

# Set true to develop without Bedrock: calls return a stub and ledger $0.
LLM_DRY_RUN=false

# --- Guardrails (Amazon Bedrock) ----------------------------------------------
# Off until there is budget for them: while off, the three guardrail stages pass
# every item through unchecked. To switch on, create the guardrail (free):
#   python -m app.pipeline.guardrails --create      (run from backend/)
# then set the three values it prints. Checks bill ~$0.15 per 1,000 characters
# per policy and are ledgered against the caps above.
GUARDRAILS_ENABLED=false
GUARDRAIL_ID=
# GUARDRAIL_VERSION=1

# --- Scheduler ---------------------------------------------------------------
# The 12h run starts inside the API server by default. An overdue run starts as
# soon as the server starts -- that run costs money (LLM, Apify, Firecrawl).
# Set false if the pipeline runs via `python -m app.scheduler` in another
# process, or by hand with `python -m app.pipeline --once`.
SCHEDULER_ENABLED=true

# "Refresh now": a run started less than this many minutes ago is not started
# again, so repeat clicks cannot keep paying.
# MANUAL_REFRESH_COOLDOWN_MINUTES=10

# --- Sources added on the page (Funded startups > Sources) -----------------------------
# Paid ones (LinkedIn, search phrases, websites without a feed) are read at most
# this often; websites with a feed are free and read every run. There is no
# login, so the number that can be added is capped.
# USER_SOURCE_HOURS=24
# MAX_USER_SOURCES=50

# --- Web search: Firecrawl --------------------------------------------------------
# https://firecrawl.dev. Billed in Firecrawl credits, separate from the caps above:
# about 2 credits per 10 results. Without a key the Web Search source is skipped.
FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=https://api.firecrawl.dev

# --- Apify: LinkedIn, Luma, Eventbrite --------------------------------------------
# https://apify.com, Settings > API & Integrations. Billed in Apify, separate from
# the caps above. Without a token those sources are skipped. Each run may charge
# at most this much:
APIFY_API_TOKEN=
# APIFY_MAX_CHARGE_USD=0.25
