# Copy to `.env` and fill in. `.env` is gitignored and never committed.
#
#   cp .env.example .env
#
# Option A -- paste keys here (simplest):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary/STS credentials:
AWS_SESSION_TOKEN=

# Option B -- use a named profile from ~/.aws/credentials instead.
# If set, this wins over the keys above.
# AWS_PROFILE=startup-news

AWS_REGION=ap-south-1

# --- Budget rails -----------------------------------------------------------
TOTAL_USD_CAP=7.00
DAILY_USD_CAP=0.50

# Set true to develop without Bedrock: calls return a stub and ledger $0.
LLM_DRY_RUN=false

# --- Scheduler ---------------------------------------------------------------
# The 12h refresh runs inside the API server by default. An overdue feed is
# refreshed as soon as the server starts -- that run costs money (enrichment,
# VCCircle scraping). Set false if ingest runs via `python -m app.scheduler`
# in another process, or by hand with `python -m app.ingest.pipeline --once`.
SCHEDULER_ENABLED=true

# "Refresh now" buttons (feed, Startup firms, VC firms): a scope refreshed less
# than this many minutes ago is not refreshed again, so repeat clicks cannot
# keep paying for enrichment and scraping.
# MANUAL_REFRESH_COOLDOWN_MINUTES=10

# --- Intelligence: Firecrawl web search + scrape --------------------------------
# Get a key at https://firecrawl.dev. Billed in Firecrawl credits, separate from
# the LLM caps above: a search of 10 results measured 2 credits; 1 per page scraped.
FIRECRAWL_API_KEY=
# Point at a self-hosted Firecrawl instead (no key needed), e.g. http://localhost:3002
# FIRECRAWL_API_URL=https://api.firecrawl.dev

# --- Insights: VC firms -------------------------------------------------------
# Firms with a feed or plain-HTML news page are read free on every refresh.
# The rest go through Firecrawl (~59 credits per round), at most this often.
# VC_FIRECRAWL_HOURS=24

# --- Insights: Events organised -------------------------------------------------
# Luma calendars are read through Apify (https://apify.com, Settings > API &
# Integrations). Billed in Apify, separate from the LLM caps above: about
# $0.002 per event returned. Pasted non-Luma websites use Firecrawl instead.
APIFY_API_TOKEN=
# Each source is read at most this often, and each Apify run may charge at most:
# EVENTS_HOURS=24
# APIFY_MAX_CHARGE_USD=0.10
