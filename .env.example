# Copy to `.env` and fill in. `.env` is gitignored and never committed.
#
#   cp .env.example .env
#
# Option A -- paste keys here (simplest):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary/STS credentials:
AWS_SESSION_TOKEN=

# Option B -- use a named profile from ~/.aws/credentials instead.
# If set, this wins over the keys above.
# AWS_PROFILE=startup-news

AWS_REGION=ap-south-1

# --- Budget rails -----------------------------------------------------------
TOTAL_USD_CAP=7.00
DAILY_USD_CAP=0.50

# Set true to develop without Bedrock: calls return a stub and ledger $0.
LLM_DRY_RUN=false

# --- Scheduler ---------------------------------------------------------------
# The 12h refresh runs inside the API server by default. An overdue feed is
# refreshed as soon as the server starts -- that run costs money (enrichment,
# VCCircle scraping). Set false if ingest runs via `python -m app.scheduler`
# in another process, or by hand with `python -m app.ingest.pipeline --once`.
SCHEDULER_ENABLED=true
